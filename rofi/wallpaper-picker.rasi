@import "~/.config/matugen/colors/rofi-colors.rasi"

configuration {
    show-icons: true;
    kb-cancel: "Escape";
    kb-accept-entry: "Return";
}

* {
    bg:          @noir-bg;
    surface:     @noir-surface;
    surface-alt: @noir-surface-alt;

    text:        @noir-text;
    muted:       @noir-muted;
    accent:      @noir-accent;

    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 10";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 58%;
    height: 44%;

    enabled: true;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 16px;
    background-color: @bg;
    padding: 14px 18px;
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 12px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

/* ── SLIM SEARCHBAR ───────────────────────────────────── */
inputbar {
    enabled: true;
    spacing: 10px;
    padding: 8px 14px;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 10px;
    background-color: @surface;
    text-color: @text;
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: @text;
    cursor: text;
    placeholder: "Pick a wallpaper...";
    placeholder-color: @muted;
}

/* ── COMPACT GALLERY GRID ─────────────────────────────── */
listview {
    enabled: true;
    columns: 4;
    lines: 2;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: true;
    spacing: 10px;
    padding: 2px;
    background-color: transparent;
}

/* ── PREVIEW CARDS ────────────────────────────────────── */
element {
    enabled: true;
    orientation: vertical;
    spacing: 4px;
    padding: 8px;
    border-radius: 12px;
    background-color: @surface;
    border: 1px;
    border-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: @surface;
    border-color: transparent;
}

element alternate.normal {
    background-color: @surface;
    border-color: transparent;
}

element selected.normal {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
    border-radius: 12px;
}

element urgent {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
    border-radius: 12px;
}

element-icon {
    background-color: transparent;
    size: 110px;
    horizontal-align: 0.5;
    cursor: inherit;
    border-radius: 8px;
}

element-text {
    background-color: transparent;
    text-color: @muted;
    padding: 4px 2px 1px 2px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 10";
}

element urgent element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 10";
}
