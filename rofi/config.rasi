@import "~/.config/matugen/colors/rofi-colors.rasi"

configuration {
    show-icons: true;
    icon-theme: "breeze-dark";

    modi: "drun,window,run";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";

    display-drun: "󰍉 ";
    display-run: "󰌑 ";
    display-window: "󰖲 ";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    kb-cancel: "Escape";
    kb-accept-entry: "Return";
    kb-remove-to-eol: "Control+E";
    kb-remove-to-sol: "Control+A";
}

* {
    bg:          @noir-bg;
    surface:     @noir-surface;
    surface-alt: @noir-surface-alt;

    text:        @noir-text;
    muted:       @noir-muted;
    accent:      @noir-accent;

    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 460px;

    enabled: true;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 14px;
    background-color: @bg;
    padding: 14px 16px;
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 10px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

/* ── COMPACT SPOTLIGHT SEARCHBAR ──────────────────────── */
inputbar {
    enabled: true;
    spacing: 10px;
    padding: 9px 13px;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 10px;
    background-color: @surface;
    text-color: @text;
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: @text;
    cursor: text;
    placeholder: "Spotlight search...";
    placeholder-color: @muted;
}

/* ── RESULTS ─────────────────────────────────────────── */
listview {
    enabled: true;
    columns: 1;
    lines: 5;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: true;
    spacing: 3px;
    background-color: transparent;
}

element {
    enabled: true;
    spacing: 10px;
    padding: 7px 11px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @muted;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @muted;
}

element alternate.normal {
    background-color: transparent;
    text-color: @muted;
}

element selected.normal {
    background-color: @surface-alt;
    text-color: @text;
    border: 1px;
    border-color: @accent;
    border-left: 3px;
    border-left-color: @accent;
}

element-icon {
    background-color: transparent;
    size: 22px;
    cursor: inherit;
    margin: 0 2px 0 0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element selected.normal element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}
